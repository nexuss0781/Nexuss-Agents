# Supabase/Vercel integration: use POSTGRES_PRISMA_URL or POSTGRES_URL.
# DATABASE_URL remains supported for Render and manual Vercel configuration.
POSTGRES_PRISMA_URL=postgres://...
POSTGRES_URL=postgres://...
DATABASE_URL=postgres://...

# Optional pool controls
DB_POOL_MAX=5
DATABASE_SSL=true

JWT_SECRET=replace-with-a-long-random-secret
VITE_APP_ID=your-manus-app-id
OAUTH_SERVER_URL=https://oauth.example.com
OWNER_OPEN_ID=your-owner-open-id

NEXUSS_AUTH_URL=https://nexuss-auth.vercel.app
NEXUSS_AUTH_PROJECT_ID=nexuss-agent-v2
NEXUSS_AUTH_REDIRECT_URI=https://your-vercel-domain.vercel.app/auth/callback
